# Ganz akkurat - Vorlage fuer Zugangsschluessel
# Kopieren nach .env und ausfuellen. Die .env selbst gehoert nie in Git.
# Ob alles sitzt, sagt `npm run zugaenge`.

# Stimme - Tarif Creator, weil erst der die kommerzielle Lizenz mitbringt.
# Die VOICE_ID gehoert zur gewaehlten Stimme; wechselt sie, muss
# ZEICHEN_PRO_SEKUNDE in src/zeit.ts mitwechseln.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Die zweite Figur. Seit dem 25.08.2026 hat der Kanal zwei sprechende Rollen:
# Volti traegt den Beleg, Watti reagiert. ElevenLabs synthetisiert je Aufruf
# mit genau einer Stimme, also braucht es zwei Kennungen.
ELEVENLABS_VOICE_ID_ZEIGER=

# Dateiablage. Buffer laedt die Videos ueber die oeffentliche URL - ein
# beschreibbarer Bucket ohne oeffentlichen Zugriff reicht nicht.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_OEFFENTLICHE_URL=

# Einplanung auf TikTok, Instagram und YouTube.
BUFFER_ACCESS_TOKEN=

# YouTube Data API - fuer den Rueckblick, nicht fuer das Hochladen. Buffer
# stellt ein; die Zahlen danach holt `npm run rueckblick` selbst. Das
# Refresh-Token schreibt `npm run youtube-anmelden` einmalig hierher.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
