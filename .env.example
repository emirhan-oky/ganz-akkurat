# SetupKlar - Vorlage fuer Zugangsschluessel
# Kopieren nach .env und ausfuellen. Die .env selbst gehoert nie in Git.
# Ob alles sitzt, sagt `npm run zugaenge`.

# Stimme - Tarif Creator, weil erst der die kommerzielle Lizenz mitbringt.
# Die VOICE_ID gehoert zur gewaehlten Stimme; wechselt sie, muss
# ZEICHEN_PRO_SEKUNDE in src/zeit.ts mitwechseln.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Dateiablage. Buffer laedt die Videos ueber die oeffentliche URL - ein
# beschreibbarer Bucket ohne oeffentlichen Zugriff reicht nicht.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_OEFFENTLICHE_URL=

# Einplanung auf TikTok, Instagram und YouTube.
BUFFER_ACCESS_TOKEN=
