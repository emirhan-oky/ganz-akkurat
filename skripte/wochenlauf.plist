<?xml version="1.0" encoding="UTF-8"?>
<!--
  Der Sonntagslauf fuer „Ganz akkurat".

  Stellt sonntags um 12:07 die fuenf Videos der Folgewoche bereit: Woche
  zusammenstellen, vertonen, rendern, Freigabeseite oeffnen, Mitteilung
  schicken. Er plant nichts ein — das Veroeffentlichen bleibt Handarbeit.

  Warum 10:00 und eine Stunde nach der Kanalwoche (9:00): Wer die naechste
  Woche waehlt, soll wissen, was die letzte getan hat.

  Die Zeiten sind am 06.09.2026 um zwei Stunden vorgezogen worden — auf Ansage,
  nachdem der erste Sonntag von selbst durchgelaufen war. Davor: 11:30 und
  12:00, und davor 12:07 mit einer Begruendung, die ihren Fall verloren hatte.

  **Die ganze Kette haengt an einer Reihenfolge**, und die ist der Grund fuer die
  Abstaende: `rueckblick` traegt um 8:30 die Zahlen nach, `kanalwoche` wertet sie
  um 9:00 aus, und dieser Lauf waehlt um 10:00 die naechste Woche.

  Warum sonntags: Die Sendewoche beginnt montags. Wer sonntags mittags
  freigibt, hat den Nachmittag Zeit, bevor am Montag um 18 Uhr das erste
  Video laeuft.

  Was er kostet: fuenf Videos sind rund 3.600 Zeichen bei ElevenLabs, etwa
  15.500 im Monat gegen ein Kontingent von 121.000. **Das ist die einzige
  Vertonung im Projekt, die ohne vorherige Zusage laeuft** — jede andere wird
  einzeln freigegeben.

  Findet die Auswahl keine gueltige Woche, bricht der Lauf ab, **bevor**
  etwas bezahlt ist, und die Mitteilung sagt es.

  Einschalten:
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/de.ganzakkurat.wochenlauf.plist
  Sofort ausloesen (zum Pruefen):
    launchctl kickstart -k gui/$UID/de.ganzakkurat.wochenlauf
  Ausschalten:
    launchctl bootout gui/$UID/de.ganzakkurat.wochenlauf
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.ganzakkurat.wochenlauf</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd ~/Projekte/Ganzakkurat &amp;&amp; skripte/mit-netz.sh skripte/sonntagslauf.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!--
    Kein RunAtLoad: Der Lauf kostet Kontingent. Ein Dienst, der bei jedem
    Anmelden vertont, waere eine Rechnung ohne Anlass.
  -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/ganzakkurat-wochenlauf.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ganzakkurat-wochenlauf.log</string>
</dict>
</plist>
